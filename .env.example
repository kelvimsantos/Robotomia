# 📄 .env.example — Cópia este archivo a ".env" y rellena tus valores.
# OJO: ".env" NO se sube al git (está en .gitignore).

# ----- Cerebro IA (Groq) -----
GROQ_API_KEY=tu_clave_groq            # https://console.groq.com

# ----- Memória persistente (Mongo) -----
MONGO_URI=mongodb://localhost:27017/robotomia

# ----- Servidor -----
PORT=3000

# ----- Módulo ALEXA (spec §22) -----
# Activa el skill de Alexa (también se controla en server/config/modules.json)
ALEXA_ENABLED=true
# ID real de tu skill (Amazon Developer Console → Endpoint).
# Vacío = modo desarrollo (no valida el applicationId); en producción OBLIGATORIO.
ALEXA_APPLICATION_ID=amzn1.ask.skill.TU_ID_REAL